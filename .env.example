# Voorbeeld voor lokaal draaien. In Railway zet je deze waarden bij Variables.
APP_PASSWORD=kies-een-lang-wachtwoord
DATABASE_URL=postgresql://postgres:wachtwoord@localhost:5432/koersplan
# Optioneel: sparren met Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optioneel: koppeling met Handelsplan (alleen lezen)
HANDELSPLAN_URL=https://handelsplan.vsonsbeek.nl
HANDELSPLAN_PASSWORD=
HANDELSPLAN_SYNC_MINUTES=30
